{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Virarkar Fashion (Django)",
      "type": "shell",
      "command": "python3 manage.py runserver 0.0.0.0:8000",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "django",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting development server at",
          "endsPattern": "Quit the server with CTRL-BREAK"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
